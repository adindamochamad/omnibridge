# Copy this file to .env and isi kunci API Anda.
# Kunci ini otomatis dipakai sebagai default saat pertama buka aplikasi.
#
# PERINGATAN: VITE_ANTHROPIC_API_KEY di-inline saat build — jangan commit .env
# ke git. Untuk distribusi internal, set kunci ini saat `npm run tauri build`.

VITE_ANTHROPIC_API_KEY=
